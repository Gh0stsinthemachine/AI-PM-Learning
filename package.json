{
  "name": "ai-pm-102",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI PM 102: a 29-round interactive course (20 minutes per round) built as a private claude.ai Artifact.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build/assemble.mjs",
    "typecheck": "tsc --noEmit",
    "lint:content": "vitest run tests/content",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "links": "node build/check-links.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.56.1",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "unist-util-visit": "5.1.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
